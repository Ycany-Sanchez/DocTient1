# Copy to .env and fill in (do NOT commit .env)
# Supabase -> Project -> Settings -> Database -> Connection string
# Use the Transaction Pooler (port 6543) for Django + pgbouncer=true

DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Alternative direct connection (port 5432, for migrate only):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
